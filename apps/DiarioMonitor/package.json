{
  "name": "diariomonitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DiarioMonitor — gestao de publicacao de atos normativos (TJMS/AGDM)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:rls": "./scripts/test-rls.sh",
    "test:ingest:doms": "./scripts/test-ingest-doms.sh",
    "test:parser:contract": "./scripts/test-parser-contract.sh",
    "ingest:doms": "node scripts/ingest-doms.mjs",
    "gates": "npm run test:rls && npm run test:schema:campos && npm run test:fila-revisao && npm run test:ingest:doms && npm run test:parser:contract && npm run test:hooks:publicacoes && npm run test:gabarito:formato",
    "ingest": "node scripts/ingest.mjs",
    "gabarito": "node scripts/pre-anotar.mjs",
    "test:gabarito:formato": "./scripts/test-gabarito-formato.sh",
    "validador": "node tools/gerar-validador.mjs",
    "test:schema:campos": "./scripts/test-schema-campos-fonte.sh",
    "test:fila-revisao": "./scripts/test-fila-revisao.sh",
    "test:hooks:publicacoes": "./scripts/test-hooks-publicacoes.sh"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}